# ─── Local-Dev Setup ──────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev): leave TURSO_DATABASE_URL unset → uses ./storage-data/imagen.db automatically
# Turso Cloud (prod): uncomment and fill in:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# ─── Anthropic Claude (vision categorize + story generation) ──────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Image generation (optional for local UI work) ────────────────────────────
ATLASCLOUD_API_KEY=
FREEPIK_API_KEY=

# ─── Storage backend ──────────────────────────────────────────────────────────
# "local" → ./storage-data, served by the dev server itself
# "forge" → S3 via Manus Forge presigned URLs (requires BUILT_IN_FORGE_*)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage-data

# Only needed when STORAGE_BACKEND=forge
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── Misc ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Change this if port 3000 is already in use on your machine.
# The app (UI + API) will be available at http://localhost:<PORT>
PORT=3000
