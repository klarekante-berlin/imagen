# ─── Local-Dev Setup ──────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# ─── Database ─────────────────────────────────────────────────────────────────
# Local docker-compose default credentials below. Override for prod.
DATABASE_URL=mysql://imagen:imagen@localhost:3306/imagen

# ─── Anthropic Claude (vision categorize + story generation) ──────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Image generation (optional for local UI work) ────────────────────────────
ATLASCLOUD_API_KEY=
FREEPIK_API_KEY=

# ─── Storage backend ──────────────────────────────────────────────────────────
# "local" → ./storage-data, served by the dev server itself
# "forge" → S3 via Manus Forge presigned URLs (requires BUILT_IN_FORGE_*)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage-data

# Only needed when STORAGE_BACKEND=forge
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── Auth / OAuth (optional — leave empty to disable login flow) ──────────────
JWT_SECRET=dev-secret-change-me-32-bytes-xxxxx
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# ─── Misc ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
